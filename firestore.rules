rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authorization functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // 1. User profiles (/users/{userId})
    match /users/{userId} {
      // Member can read their own profile; Admin can read all user profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // User profile creation: User can create their initial profile (defaulting to member unless admin)
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'member' || 
        isAdmin()
      );
      
      // Prevent members from elevating their own role to 'admin'
      allow update: if (
        isOwner(userId) && 
        request.resource.data.role == resource.data.role
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // 2. Member Tasks (/tasks/{taskId})
    match /tasks/{taskId} {
      // Member can ONLY read tasks assigned specifically to their UID
      allow read: if isSignedIn() && (
        resource.data.assignedTo == request.auth.uid || isAdmin()
      );
      
      // Member can update task status of their own assigned tasks
      allow update: if isSignedIn() && (
        (resource.data.assignedTo == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) || 
        isAdmin()
      );
      
      // Admin task management
      allow create, delete: if isAdmin();
    }

    // 3. EOD Reports (/eod_reports/{reportId})
    match /eod_reports/{reportId} {
      // Member can ONLY read their own EOD reports; Admin can read all reports
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      
      // Member can create EOD report strictly tied to their own UID
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid
      );
      
      // Member can update their own today report; Admin can update any report
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      
      allow delete: if isAdmin();
    }
  }
}
